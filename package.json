{
    "name": "@andresclua/custom-cursor",
    "private": false,
    "version": "1.2.0",
    "description": "A lightweight JavaScript library for creating customizable animated cursors",
    "type": "module",
    "main": "./dist/CustomCursor.umd.js",
    "module": "./dist/CustomCursor.es.js",
    "exports": {
        ".": {
            "import": "./dist/CustomCursor.es.js",
            "require": "./dist/CustomCursor.umd.js"
        }
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "cursor",
        "custom-cursor",
        "mouse",
        "pointer",
        "animation",
        "dom",
        "javascript",
        "ui"
    ],
    "scripts": {
        "dev": "vite",
        "dev:site": "vite --config vite.config.site.js",
        "build": "vite build",
        "build:site": "vite build --config vite.config.site.js",
        "preview": "vite preview"
    },
    "devDependencies": {
        "gsap": "^3.15.1",
        "sass": "^1.80.6",
        "vite": "^5.4.10"
    }
}
